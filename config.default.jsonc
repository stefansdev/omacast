{
  // Omacast defaults. Your settings live in ~/.config/omacast/config.jsonc and
  // only need the keys you change. Omacast Settings (search "Settings") edits
  // that file for you; snippets live in ~/.config/omacast/snippets.json.

  "general": {
    "hotkey": "SUPER + SPACE",          // opens Omacast
    "menuHotkey": "SUPER + ALT + SPACE", // Omarchy menu, displaced from Super+Space
    "textSize": "default",              // default | large | larger
    "windowMode": "expanded",           // expanded | compact (only the search bar until you type)
    "showFavoritesInCompact": true,
    "showOn": "focused",                // focused | cursor | primary
    "popToRoot": 0,                     // seconds after closing before resetting; -1 never
    "escapeBehavior": "back"            // back (clear, go back, then close) | close
  },

  "search": {
    "sensitivity": "medium",            // high | medium | low (low allows looser matches)
    "windows": true,
    "files": true,
    "fileMinChars": 3,
    "calculator": true,
    "fallbacks": ["ai", "web", "define", "note"],
    "url": "https://www.google.com/search?q={query}"
  },

  // Row ids pinned to the top of the empty palette (Ctrl+K → Add to Favorites).
  "favorites": [],

  // Per-command alias, hotkey and enabled state, keyed by row id.
  // Example: "window.left-half": { "alias": "lh", "hotkey": "SUPER + CTRL + LEFT" }
  "overrides": {},

  // Quicklinks: type the keyword followed by text, e.g. "gh quickshell".
  // {query} is replaced with the URL-encoded text.
  "quicklinks": [
    { "name": "Search Google", "keyword": "g", "icon": "\uf1a0", "url": "https://www.google.com/search?q={query}" },
    { "name": "Search DuckDuckGo", "keyword": "ddg", "icon": "󰇥", "url": "https://duckduckgo.com/?q={query}" },
    { "name": "Search GitHub", "keyword": "gh", "icon": "\uf09b", "url": "https://github.com/search?q={query}&type=repositories" },
    { "name": "Search YouTube", "keyword": "yt", "icon": "\uf16a", "url": "https://www.youtube.com/results?search_query={query}" },
    { "name": "Arch Wiki", "keyword": "aw", "icon": "󰣇", "url": "https://wiki.archlinux.org/index.php?search={query}" },
    { "name": "Arch User Repository", "keyword": "aur", "icon": "󰣇", "url": "https://aur.archlinux.org/packages?K={query}" },
    { "name": "Google Maps", "keyword": "maps", "icon": "󰍎", "url": "https://www.google.com/maps/search/{query}" },
    { "name": "Translate", "keyword": "tr", "icon": "󰗊", "url": "https://translate.google.com/?sl=auto&tl=en&text={query}" }
  ],

  // Custom commands. "terminal": true runs them in a terminal window.
  "commands": [
    { "name": "System Monitor", "icon": "󰍛", "command": "btop", "terminal": true },
    { "name": "Update Omarchy", "icon": "\uf021", "command": "omarchy update", "terminal": true }
  ],

  "snippetSettings": {
    "expansion": true,                  // expand keywords as you type in any app
    "withinWords": false,
    "exclude": ["1password", "bitwarden", "keepassxc", "proton pass"],
    "primaryAction": "paste"            // paste | copy
  },

  "clipboard": { "primaryAction": "paste" },

  "notes": {
    "dir": "~/notes",
    "hotkey": "SUPER + ALT + N",
    "formatBar": true,
    "escapeCloses": true,
    "textSize": 15
  },

  "files": { "roots": ["~"], "maxResults": 12 },

  // Quick AI uses the Claude Code CLI with your existing login.
  "ai": { "enabled": true, "model": "haiku", "instructions": "" }
}
